{
    "name": "horde/translation",
    "description": "Translation library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Translation",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "gettext",
        "icu",
        "messageformat",
        "json"
    ],
    "time": "2026-04-29",
    "repositories": [],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {},
    "suggest": {
        "ext-gettext": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Translation": "lib/"
        },
        "psr-4": {
            "Horde\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Translation\\Test\\": "test/",
            "Horde\\Translation\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}